# ─────────────────────────────────────────────────────────────
# CivicPulse environment configuration
# Copy to .env (`npm run setup` does this for you) and adjust.
# Only variables prefixed NEXT_PUBLIC_ are exposed to the browser.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string.
#  - `npm run db:start` (embedded Postgres, no Docker) listens on 5433
#  - `docker compose up db` listens on 5432
DATABASE_URL="postgresql://civicpulse:civicpulse@localhost:5433/civicpulse?schema=public"

# Auth (NextAuth). Generate a secret with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
# Allow citizens to self-register from /register.
ALLOW_PUBLIC_REGISTRATION="true"

# Media storage. Files are always served through an authenticated route (never a public bucket).
#  - "local": writes to UPLOAD_DIR (use a persistent volume in production)
#  - "s3":    any S3-compatible store — AWS S3, Cloudflare R2, MinIO, Supabase Storage (S3 API)
STORAGE_PROVIDER="local"
UPLOAD_DIR="./storage/uploads"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"
S3_PREFIX=""
MAX_IMAGE_MB="10"
MAX_VIDEO_MB="50"

# AI inference. Leave AI_SERVICE_URL empty to use the built-in CivicVision-Lite analyzer.
# Set it to the FastAPI service (ai-service/) to use YOLO, e.g. http://localhost:8000
AI_SERVICE_URL=""
AI_SERVICE_TIMEOUT_MS="8000"

# Deduplication tuning.
DEDUP_RADIUS_M="60"
DEDUP_WINDOW_DAYS="30"

# Priority score (0-100) at or above which an urgent alert is raised.
URGENT_PRIORITY_THRESHOLD="75"

# Notification hooks (all optional). Without them alerts are recorded in-app and logged.
# Slack-compatible incoming webhook URL:
NOTIFY_WEBHOOK_URL=""
# Comma-separated recipients for the mock email/SMS channels (logged, not sent):
NOTIFY_EMAIL_TO="ops@example.gov"
NOTIFY_SMS_TO=""

# Shared secret for scheduled jobs: GET /api/cron/recompute with `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET="change-me-cron-secret"

# Reverse geocoding through OpenStreetMap Nominatim (please respect its usage policy).
ENABLE_REVERSE_GEOCODING="false"
GEOCODER_USER_AGENT="CivicPulse/1.0 (ops@example.gov)"

# Map tiles. The default OpenStreetMap server is fine for development and light use; for production
# traffic use a provider with an SLA (MapTiler, Stadia, Mapbox raster, self-hosted) — see docs/deployment.md.
NEXT_PUBLIC_MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
NEXT_PUBLIC_MAP_ATTRIBUTION="&copy; OpenStreetMap contributors"
